{
  "$schema": "http://json.schemastore.org/template",
  "identity": "Local.EFBoilerplate",
  "name": "ASP.NET Core MVC + EF Core (SQL Server in Docker)",
  "shortName": "efmvc",
  "sourceName": "EFBoilerplate",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        ".git/**",
        "**/.vs/**",
        "**/.idea/**",
        "**/.DS_Store",
        "README.md"
      ]
    }
  ],
  "classifications": ["Web", "MVC", "EF Core"],
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
